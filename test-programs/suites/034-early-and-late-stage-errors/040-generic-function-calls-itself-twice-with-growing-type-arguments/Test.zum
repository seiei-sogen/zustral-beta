module body Test is
    record Box[T: Free]: Free is
        value: T;
    end;

    generic [T: Free]
    function grow(x: T, n: Int32): Int32 is
        if n = 0 then
            return 0;
        end if;
        let wrapped: Option[T] := Some(value => x);
        let boxed: Box[T] := Box(value => x);
        return grow(wrapped, n - 1) + grow(boxed, n - 1);
    end;

    function main(): ExitCode is
        printLn(grow(1, 3));
        return ExitSuccess();
    end;
end module body.
