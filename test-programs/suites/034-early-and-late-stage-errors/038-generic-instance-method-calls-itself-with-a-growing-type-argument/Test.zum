module body Test is
    record Box[T: Free]: Free is
        value: T;
    end;

    typeclass Nested(T: Free) is
        method nest(x: T, n: Int32): Int32;
    end;

    instance Nested(Int32) is
        method nest(x: Int32, n: Int32): Int32 is
            return n;
        end;
    end;

    generic [U: Free(Nested)]
    instance Nested(Box[U]) is
        method nest(x: Box[U], n: Int32): Int32 is
            if n = 0 then
                return 0;
            end if;
            let boxed: Box[Box[U]] := Box(value => x);
            return nest(boxed, n - 1);
        end;
    end;

    function main(): ExitCode is
        let box: Box[Int32] := Box(value => 1);
        printLn(nest(box, 3));
        return ExitSuccess();
    end;
end module body.
