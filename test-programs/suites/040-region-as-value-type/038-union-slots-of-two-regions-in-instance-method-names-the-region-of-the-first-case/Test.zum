module body Test is
    union Choice[R: Region, S: Region]: Free is
        case HeldFirst is
            r: R;
        case HeldSecond is
            s: S;
    end;

    typeclass Shape(T: Type) is
        generic [R: Region, S: Region]
        method area(x: T, y: Choice[S, R]): Int32;
    end;

    instance Shape(Int32) is
        generic [R: Region, S: Region]
        method area(x: Int32, y: Choice[S, R]): Int32 is
            return x;
        end;
    end;

    function main(): ExitCode is
        printLn("ok");
        return ExitSuccess();
    end;
end module body.
