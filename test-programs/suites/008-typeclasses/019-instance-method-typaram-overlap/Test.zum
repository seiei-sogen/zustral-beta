module body Test is
    typeclass Foo(T: Free) is
        method foo(x: T): Unit;
    end;

    record Box[A: Free]: Free is
        value: A;
    end;

    generic [U: Free]
    instance Foo(Box[U]) is
        generic [U: Type]
        method foo(x: U): Unit is
            return nil;
        end;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
