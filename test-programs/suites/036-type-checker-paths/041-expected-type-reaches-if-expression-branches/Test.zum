module body Test is
    function main(): ExitCode is
        let c: Bool := true;
        let x: Option[Int32] := if c then None() else None();
        case x of
            when Some(value: Int32) do
                printLn(value);
            when None do
                printLn("none");
        end case;
        return ExitSuccess();
    end;
end module body.
